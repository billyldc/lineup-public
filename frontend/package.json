{
  "name": "lineup-app",
  "version": "0.1.0",
  "type": "module",
  "description": "lineup project manager — Electron frontend",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "demo": "node ../scripts/run-demo.mjs",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "postinstall": "electron-rebuild -f -o better-sqlite3 && (electron-rebuild -f -o node-pty || echo 'WARN: node-pty rebuild failed; embedded terminal disabled. Fix: pip3 install setuptools && npx electron-rebuild -f -o node-pty'); chmod +x node_modules/node-pty/prebuilds/*/spawn-helper 2>/dev/null || true",
    "dist": "electron-vite build && electron-builder"
  },
  "devDependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "better-sqlite3": "^12.8.0",
    "electron": "^41.2.0",
    "electron-rebuild": "^3.2.9",
    "electron-vite": "^5.0.0",
    "typescript": "^6.0.2",
    "vite": "^7.3.2"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.2.2",
    "@tailwindcss/vite": "^4.2.2",
    "@types/turndown": "^5.0.6",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "katex": "^0.16.11",
    "lucide-react": "^1.8.0",
    "mammoth": "^1.12.0",
    "node-pty": "^1.1.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.2",
    "turndown": "^7.2.4",
    "xlsx": "^0.18.5"
  },
  "build": {
    "appId": "com.lineup.app",
    "productName": "lineup",
    "mac": {
      "target": "dmg"
    },
    "files": [
      "out/**/*"
    ],
    "extraResources": []
  }
}